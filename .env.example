# URL do painel (domínio onde este app roda)
NEXT_PUBLIC_SITE_URL=https://painel.seudominio.com.br

# Supabase (projeto dedicado ao norat)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# norat — destino CNAME para domínios de campanha (edge na Vercel)
TRAFFIC_DNS_CNAME_TARGET=trafficshield-panel-iota.vercel.app
NEXT_PUBLIC_TRAFFIC_DNS_CNAME_TARGET=trafficshield-panel-iota.vercel.app
TRAFFIC_DOMAIN_SLOT_LIMIT=10

# Opcional: domínio padrão das campanhas no site do cliente
# TRAFFIC_SITE_DOMAIN=loja.cliente.com.br

# Opcional: secret interno (logs entre middleware e APIs)
TRAFFIC_INTERNAL_SECRET=altere-este-secret
