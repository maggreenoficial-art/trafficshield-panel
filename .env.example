# URL do painel (domínio onde este app roda)
NEXT_PUBLIC_SITE_URL=https://www.norat.cloud

# Supabase (projeto dedicado ao norat)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# norat — destino CNAME para domínios de campanha (edge na Vercel)
TRAFFIC_DNS_CNAME_TARGET=www.norat.cloud
NEXT_PUBLIC_TRAFFIC_DNS_CNAME_TARGET=www.norat.cloud
TRAFFIC_DOMAIN_SLOT_LIMIT=10

# Opcional: domínio padrão das campanhas no site do cliente
# TRAFFIC_SITE_DOMAIN=loja.cliente.com.br

# Opcional: secret interno (logs entre middleware e APIs) — obrigatório em produção
TRAFFIC_INTERNAL_SECRET=altere-este-secret

# Cadastro público: 1 = liberado (padrão), 0 = só suporte cria conta
# ALLOW_PUBLIC_SIGNUP=1

# Modo teste vp_test sem token (só use em staging). Em produção, vp_test exige vp_t válido.
# TRAFFIC_ALLOW_TEST_MODE=0

# Vercel — provisiona SSL/domínio de campanha automaticamente
# Crie em https://vercel.com/account/tokens
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Kie AI — geração de imagem/vídeo (Storyboards)
# https://docs.kie.ai/ | https://kie.ai/api-key
KIE_AI_API_KEY=
# Opcional: token do webhook /api/kie/callback (senão usa TRAFFIC_INTERNAL_SECRET)
# KIE_CALLBACK_SECRET=
